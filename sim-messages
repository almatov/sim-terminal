#!/bin/sh
#
# sim-messages
#
# Print the text of incoming SMS messages as they arrive
#
# The text is printed between the +CMGR: or +CMGL: header and the final OK. An OK line is held back: if the next
# line is OK or a +CMGL: header too, the held line was the message text; otherwise it was the final OK.
#
